# Supabase CLI link state (no secrets, but machine-local)
supabase/.temp/

# Wrangler's local build/dev state
.wrangler/

# Throwaway probe/diff scripts. They read .env at runtime, so keeping them out
# of git also keeps an accidental `git add -A` from committing scratch work.
.tmp2020/
.tmp2026/
scratch/

# Python build artifacts
__pycache__/
*.pyc
temp_inspect/
*_raw_dump.json
