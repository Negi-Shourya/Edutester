{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "paths": {
      "npm:@supabase/supabase-js@*": ["./node_modules/@supabase/supabase-js"],
      "npm:*": ["./node_modules/*"]
    }
  },
  "include": ["supabase/functions/**/*.ts"]
}
