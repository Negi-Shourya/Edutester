{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edutester",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "routes": [
    { "pattern": "edutester.in", "custom_domain": true },
    { "pattern": "www.edutester.in", "custom_domain": true },
    { "pattern": "edutester.in/*", "zone_name": "edutester.in" },
    { "pattern": "www.edutester.in/*", "zone_name": "edutester.in" }
  ],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "vars": {
    "VITE_SUPABASE_URL": "https://gvsgromfsqvywawauzfi.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_E4i5onSWlO_NBqE8nsHXig_K25O1Lqv",
    "VITE_RAZORPAY_KEY_ID": "rzp_test_T4mv3dMataBt2s"
  },

  "observability": {
    "enabled": true
  }
}
